# Adzuna Job API — get free keys at https://developer.adzuna.com
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Optional: default Adzuna country code if user's country isn't mapped (e.g. 'us', 'gb')
ADZUNA_COUNTRY=us

# Resend email API — get free key at https://resend.com (3,000 emails/mo free)
RESEND_API_KEY=re_your_key_here

# Polar payments (Merchant of Record) — https://polar.sh
# Use the sandbox values first, then swap to production once your account clears.
POLAR_ACCESS_TOKEN=polar_oat_your_org_access_token
POLAR_PRODUCT_ID=your_unlock_product_id
POLAR_WEBHOOK_SECRET=your_webhook_signing_secret
# 'sandbox' while testing, 'production' when live
POLAR_SERVER=sandbox
